{
  "name": "delphic-dbviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only viewer for database dump files (super admin only). Separate from the app: shares no code with server/ or client/.",
  "scripts": {
    "start": "node server/index.js",
    "test": "jest --runInBand",
    "build:web": "vite build web",
    "dev:web": "vite web"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "jest": "29.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supertest": "7.0.0",
    "vite": "5.4.11"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.test.js"]
  }
}
