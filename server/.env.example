NODE_ENV=development
PORT=4000
# debug|info|warn|error — see docs/BACKEND-LOGGING.md
LOG_LEVEL=debug

# connection_limit/pool_timeout are explicit rather than Prisma's default guess
# (num_physical_cpus*2+1 — unreliable under Docker Desktop's cgroup reporting).
# 10 is plenty for one dev server; bump only if you see pool_timeout errors
# under real load. See docs/guides/DATABASE-CONNECTION-POOLING.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/requirement_dashboard?connection_limit=10&pool_timeout=20

# Generate with: openssl rand -hex 32
# Production refuses missing, short (<32), or placeholder secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Public SPA origin. Production must not be localhost.
CORS_ORIGIN=http://localhost:5173

# Business timezone for human-readable dates/times in notifications & emails
# (the server clock is UTC). IANA name, e.g. Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# In-process background jobs (interview reminder cron). Runs unless set to false.
# Automatically off when NODE_ENV=test. Set ENABLE_JOBS=false on any extra API
# instance if the service is ever scaled horizontally. See docs/guides/DEPLOY-RUNBOOK.md.
ENABLE_JOBS=true

# Email (vendor emails, interview invites, ...). Leave unset and queued mail is marked 'skipped'.
# Either one URL ...
# NOTIFICATIONS_SMTP_URL=smtps://user:pass@smtp.example.com:465
# ... or the separate values (nothing to URL-encode). Port 465 = implicit TLS; 587 = STARTTLS. See docs/guides/EMAIL-SMTP-PRODUCTION.md.
# NOTIFICATIONS_SMTP_HOST=
# NOTIFICATIONS_SMTP_PORT=587
# NOTIFICATIONS_SMTP_SECURE=false
# NOTIFICATIONS_SMTP_USER=
# NOTIFICATIONS_SMTP_PASS=
# From address shown to recipients, e.g. Delphic One <noreply.secure@delphic.in>
# NOTIFICATIONS_EMAIL_FROM=
# Or Microsoft Graph (Microsoft 365, works when SMTP AUTH is disabled; wins over SMTP). The mailbox is NOTIFICATIONS_EMAIL_FROM.
# Azure app with the Mail.Send APPLICATION permission + admin consent, restricted to that mailbox. See docs/guides/EMAIL-SMTP-PRODUCTION.md.
# Reserved for the future MS Teams channel. Unused today.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=

# AI interview (first-round screening). Get the key from console.anthropic.com; never commit it.
# ANTHROPIC_API_KEY=
# AI_INTERVIEW_MODEL=claude-sonnet-5-5
