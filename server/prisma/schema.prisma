// --- Finance: calculation locking + versioning (one system for all) --------
//
// Operational data -> calculation -> review -> LOCK -> snapshot. One row per
// (org, kind, scope, month): `billing` is scoped to a project (Account id),
// the others to the whole org ('org'). A lock writes an immutable
// FinancialCalculationVersion holding the full computed result; later
// changes to attendance / timesheets / leave / salary never rewrite it —
// they raise a FinancialCalculationChange and flip the status to
// change_detected, and only an explicit recalculation (a NEW version) moves
// the figures. See modules/calculations/calculations.service.js.
enum CalculationKind {
  billing
  salary
  resource_revenue
  vendor_payment
  financials
  // Per-record locks in Live Analytics (scope_key = employee / vendor / expense record).
  salary_employee
  vendor_bill
  expense
}

enum CalculationStatus {
  draft
  reviewed
  locked
  change_detected
  reopened
}

enum CalculationChangeStatus {
  open
  accepted
  dismissed
}

model FinancialCalculation {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id             String            @db.Uuid
  org                Org               @relation(fields: [org_id], references: [id])
  kind               CalculationKind
  scope_key          String
  scope_label        String?
  period_month       Int
  period_year        Int
  status             CalculationStatus @default(draft)
  current_version    Int               @default(0)
  reviewed_by        String?           @db.Uuid
  reviewed_at        DateTime?
  locked_by          String?           @db.Uuid
  locked_at          DateTime?
  reopened_by        String?           @db.Uuid
  reopened_at        DateTime?
  change_detected_at DateTime?
  created_by         String?           @db.Uuid
  created_at         DateTime          @default(now())
  updated_at         DateTime          @default(now()) @updatedAt

  versions FinancialCalculationVersion[]
  changes  FinancialCalculationChange[]

  @@unique([org_id, kind, scope_key, period_year, period_month])
  @@index([org_id, period_year, period_month])
  @@index([org_id, status])
  @@map("financial_calculations")
}

// Immutable once written — never updated, only added to.
model FinancialCalculationVersion {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculation_id String               @db.Uuid
  calculation    FinancialCalculation @relation(fields: [calculation_id], references: [id], onDelete: Cascade)
  version        Int
  amount         Decimal              @db.Decimal(16, 2)
  currency       Currency             @default(INR)
  // The whole computed result (totals, per-line figures, source record ids)
  // exactly as it stood when locked.
  snapshot       Json
  reason         String?
  created_by     String?              @db.Uuid
  created_at     DateTime             @default(now())

  @@unique([calculation_id, version])
  @@map("financial_calculation_versions")
}

// A change to operational data inside an already-locked period.
model FinancialCalculationChange {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculation_id    String                  @db.Uuid
  calculation       FinancialCalculation    @relation(fields: [calculation_id], references: [id], onDelete: Cascade)
  source_type       String
  source_id         String?
  org_membership_id String?                 @db.Uuid
  account_id        String?                 @db.Uuid
  date              DateTime?               @db.Date
  description       String
  old_value         Json?
  new_value         Json?
  previous_amount   Decimal?                @db.Decimal(16, 2)
  potential_amount  Decimal?                @db.Decimal(16, 2)
  changed_by        String?                 @db.Uuid
  detected_at       DateTime                @default(now())
  status            CalculationChangeStatus @default(open)
  resolved_by       String?                 @db.Uuid
  resolved_at       DateTime?
  resolved_version  Int?
  resolution_note   String?

  @@index([calculation_id, status])
  @@map("financial_calculation_changes")
}

// ---------------------------------------------------------------------------
// Zephyr Infrastructure workspace (standalone Zx* module, 2026-10).
// Nothing here references Delphic Global business tables. Every row is
// org-scoped; services must filter by org_id explicitly (reads are not
// auto-filtered). See docs/features/ZEPHYR-INFRASTRUCTURE.md.
// ---------------------------------------------------------------------------

// One row per org: company-level Zephyr settings (valuation, numbering).
model ZxSetting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id             String   @unique @db.Uuid
  org                Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  currency           String   @default("INR")
  valuation_method   String   @default("revenue_multiple") // manual | revenue_multiple | profit_multiple
  valuation_multiple Decimal  @default(3) @db.Decimal(8, 2)
  valuation_manual   Decimal? @db.Decimal(16, 2)
  project_prefix     String   @default("ZX-P")
  project_seq        Int      @default(0)
  lead_prefix        String   @default("ZL")
  lead_seq           Int      @default(0)
  property_prefix    String   @default("ZP")
  property_seq       Int      @default(0)
  task_prefix        String   @default("ZT")
  task_seq           Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  @@map("zx_settings")
}

// Admin-editable revenue / expense categories (not hard-coded).
model ZxCategory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String    @db.Uuid
  org        Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  kind       String // revenue | expense
  name       String
  active     Boolean   @default(true)
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?
  entries    ZxLedgerEntry[]

  @@unique([org_id, kind, name])
  @@index([org_id, kind])
  @@map("zx_categories")
}

// Zephyr's own audit trail (before/after JSON, actor, optional reason).
model ZxAudit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  entity     String
  entity_id  String?  @db.Uuid
  action     String
  before     Json?
  after      Json?
  reason     String?
  actor_id   String?  @db.Uuid
  created_at DateTime @default(now())

  @@index([org_id, entity, entity_id])
  @@index([org_id, created_at])
  @@map("zx_audit")
}

// The Zephyr people roster. Z0 holds only what roles need (name, optional
// login, access role); Z4 extends it with employment and pay fields.
// access_role: manager | staff | none. Org-membership admins are Zephyr
// admins regardless of this row.
model ZxPerson {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String    @db.Uuid
  org         Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  name        String
  user_id     String?   @db.Uuid
  user        User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  access_role String    @default("none")
  active      Boolean   @default(true)
  kind        String    @default("employee")
  designation String?
  phone       String?
  email       String?
  joining_date DateTime? @db.Date
  leaving_date DateTime? @db.Date
  pay_basis   String?
  rate        Decimal?  @db.Decimal(14, 2)
  vendor_party_id String? @db.Uuid
  vendor_party ZxParty? @relation(fields: [vendor_party_id], references: [id], onDelete: SetNull)
  notes       String?
  assignments ZxAssignment[]
  salary_records ZxSalaryRecord[]
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  deleted_at  DateTime?

  @@unique([org_id, user_id])
  @@index([org_id])
  @@map("zx_people")
}

// Z1: one directory of clients and vendors / subcontractors.
// kind: client | vendor | both. status: active | inactive.
model ZxParty {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String    @db.Uuid
  org           Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  kind          String    @default("client")
  name          String
  contact_name  String?
  phone         String?
  email         String?
  gstin         String?
  pan           String?
  address       String?
  city          String?
  state         String?
  country       String?
  company_name  String?
  interested_services String[] @default([])
  vendor_category     String?
  materials_services  String?
  payment_terms String?
  status        String    @default("active") // active | inactive | hold
  notes         String?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt
  deleted_at    DateTime?
  leads         ZxLead[]
  projects      ZxProject[]
  work_orders   ZxWorkOrder[]
  contractor_people ZxPerson[]
  ledger_entries ZxLedgerEntry[]

  @@index([org_id, kind, status])
  @@index([org_id, name])
  @@map("zx_parties")
}

// Z1: files with a category, reference number and expiry, owned by a Zephyr
// record (owner_type party | project | person | lead). Polymorphic owner, so no FK;
// the service validates the owner belongs to the same org.
model ZxDocument {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String    @db.Uuid
  org         Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  owner_type  String
  owner_id    String    @db.Uuid
  category    String    @default("other")
  title       String
  ref_no      String?
  issue_date  DateTime? @db.Date
  expiry_date DateTime? @db.Date
  file_url    String
  file_name   String?
  size_bytes  Int?
  uploaded_by String?   @db.Uuid
  created_at  DateTime  @default(now())
  deleted_at  DateTime?

  @@index([org_id, owner_type, owner_id])
  @@index([org_id, expiry_date])
  @@map("zx_documents")
}

// Z2: Zephyr leads, first contact to won / lost.
// category: self_project | client_project | other. stage: new | contacted | site_visit |
// proposal | negotiation | won | lost. A self_project lead states its basis
// (investor | customer_deal | project_type) and the value for that basis.
model ZxLead {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id             String    @db.Uuid
  org                Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  name               String
  category           String    @default("client_project")
  self_project_basis String?
  basis_value        String?
  party_id           String?   @db.Uuid
  party              ZxParty?  @relation(fields: [party_id], references: [id], onDelete: SetNull)
  contact_name       String?
  phone              String?
  email              String?
  source             String?
  location           String?
  estimated_value    Decimal?  @db.Decimal(16, 2)
  expected_close     DateTime? @db.Date
  stage              String    @default("new") // new | in_discussion | negotiation | on_hold | won | closed | dropped
  lost_reason        String?
  owner_id           String?   @db.Uuid
  notes              String?
  project_id         String?   @db.Uuid
  closed_at          DateTime?
  code               String?
  service_type       String?
  company            String?
  address            String?
  city               String?
  state              String?
  assignee_id        String?   @db.Uuid
  contractor_id      String?   @db.Uuid
  expected_start     DateTime? @db.Date
  expected_end       DateTime? @db.Date
  expected_profit    Decimal?  @db.Decimal(16, 2)
  property_ref       String?
  description        String?
  details            Json?
  created_by         String?   @db.Uuid
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt
  deleted_at         DateTime?
  activities         ZxLeadActivity[]

  @@index([org_id, stage])
  @@index([org_id, owner_id])
  @@index([org_id, service_type])
  @@map("zx_leads")
}

// Z2: calls, visits, meetings and notes on a lead; stage moves are logged here too.
model ZxLeadActivity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id           String    @db.Uuid
  org              Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  lead_id          String    @db.Uuid
  lead             ZxLead    @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  kind             String    @default("note")
  summary          String
  follow_up_date   DateTime? @db.Date
  follow_up_done   Boolean   @default(false)
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now())

  @@index([lead_id, created_at])
  @@index([org_id, follow_up_date])
  @@map("zx_lead_activities")
}

// Z3: a Zephyr project. kind: self (own-developed) | client. status: planning | active |
// on_hold | completed | cancelled. code = settings.project_prefix + running number.
// progress_pct is the manual figure, used only while the project has no milestones
// (otherwise progress is the weighted average of milestone percent_done).
model ZxProject {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String    @db.Uuid
  org            Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  code           String
  name           String
  kind           String    @default("client")
  party_id       String?   @db.Uuid
  party          ZxParty?  @relation(fields: [party_id], references: [id], onDelete: SetNull)
  lead_id        String?   @db.Uuid
  location       String?
  status         String    @default("planned") // planned | active | on_hold | completed | cancelled | closed
  start_date     DateTime? @db.Date
  end_date       DateTime? @db.Date
  contract_value Decimal?  @db.Decimal(16, 2)
  budget         Decimal?  @db.Decimal(16, 2)
  progress_pct   Int       @default(0)
  manager_id     String?   @db.Uuid
  notes          String?
  service_type   String?
  actual_end     DateTime? @db.Date
  agreement_ref  String?
  property_id    String?   @db.Uuid
  expected_profit Decimal? @db.Decimal(16, 2)
  assignee_id    String?   @db.Uuid
  contractor_id  String?   @db.Uuid
  description    String?
  details        Json?
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  deleted_at     DateTime?
  milestones     ZxMilestone[]
  work_orders    ZxWorkOrder[]
  assignments    ZxAssignment[]
  ledger_entries ZxLedgerEntry[]
  plans          ZxPlan[]

  @@unique([org_id, code])
  @@index([org_id, status])
  @@index([org_id, service_type])
  @@map("zx_projects")
}

// Z3: a billable / trackable step of a project. status follows percent_done
// (0 pending, 1-99 in_progress, 100 done); weight sets its share of project progress.
model ZxMilestone {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String    @db.Uuid
  org            Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  project_id     String    @db.Uuid
  project        ZxProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name           String
  due_date       DateTime? @db.Date
  weight         Int       @default(1)
  percent_done   Int       @default(0)
  status         String    @default("pending")
  billing_amount Decimal?  @db.Decimal(16, 2)
  billed         Boolean   @default(false)
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  deleted_at     DateTime?
  ledger_entries ZxLedgerEntry[]

  @@index([project_id, sort_order])
  @@map("zx_milestones")
}

// Z3: work given to a vendor / subcontractor (a ZxParty of kind vendor or both) on a project.
// status: draft | issued | in_progress | completed | cancelled. billed_to_date <= value.
model ZxWorkOrder {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String    @db.Uuid
  org            Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  project_id     String    @db.Uuid
  project        ZxProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  vendor_id      String    @db.Uuid
  vendor         ZxParty   @relation(fields: [vendor_id], references: [id])
  wo_number      String?
  scope          String
  value          Decimal   @db.Decimal(16, 2)
  billed_to_date Decimal   @default(0) @db.Decimal(16, 2)
  status         String    @default("draft")
  issued_on      DateTime? @db.Date
  notes          String?
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  deleted_at     DateTime?
  ledger_entries ZxLedgerEntry[]

  @@index([project_id])
  @@index([org_id, vendor_id])
  @@map("zx_work_orders")
}

// Z4: a person on a project. allocation_pct is the share of their time; a person's
// overlapping assignments may not add up to more than 100.
model ZxAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String    @db.Uuid
  org            Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  person_id      String    @db.Uuid
  person         ZxPerson  @relation(fields: [person_id], references: [id], onDelete: Cascade)
  project_id     String    @db.Uuid
  project        ZxProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  role           String?
  from_date      DateTime? @db.Date
  to_date        DateTime? @db.Date
  allocation_pct Int       @default(100)
  created_at     DateTime  @default(now())
  deleted_at     DateTime?

  @@index([person_id])
  @@index([project_id])
  @@map("zx_assignments")
}

// Z4: one pay slip per person per month (month = YYYY-MM). pay_basis / rate are
// snapshotted when the slip is generated. status: draft | approved | paid.
// project_split = [{ project_id, pct, amount }] (cost allocation across projects).
model ZxSalaryRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String    @db.Uuid
  org           Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  person_id     String    @db.Uuid
  person        ZxPerson  @relation(fields: [person_id], references: [id], onDelete: Cascade)
  month         String
  pay_basis     String
  rate          Decimal   @db.Decimal(14, 2)
  days          Decimal?  @db.Decimal(6, 2)
  gross         Decimal   @default(0) @db.Decimal(14, 2)
  deductions    Decimal   @default(0) @db.Decimal(14, 2)
  net           Decimal   @default(0) @db.Decimal(14, 2)
  status        String    @default("draft")
  project_split Json?
  paid_on       DateTime? @db.Date
  approved_by   String?   @db.Uuid
  approved_at   DateTime?
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  @@unique([person_id, month])
  @@index([org_id, month])
  @@map("zx_salary_records")
}

// Z5: the money ledger. type: revenue | expense. status: planned | actual (only actual
// counts in the books). amount excludes tax; tax is tracked separately (GST). Salaries are
// NOT ledger entries - they come from approved / paid ZxSalaryRecord rows. Documents attach
// via ZxDocument (owner_type = entry).
model ZxLedgerEntry {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String       @db.Uuid
  org           Org          @relation(fields: [org_id], references: [id], onDelete: Cascade)
  entry_date    DateTime     @db.Date
  type          String
  category_id   String       @db.Uuid
  category      ZxCategory   @relation(fields: [category_id], references: [id])
  project_id    String?      @db.Uuid
  project       ZxProject?   @relation(fields: [project_id], references: [id], onDelete: SetNull)
  party_id      String?      @db.Uuid
  party         ZxParty?     @relation(fields: [party_id], references: [id], onDelete: SetNull)
  work_order_id String?      @db.Uuid
  work_order    ZxWorkOrder? @relation(fields: [work_order_id], references: [id], onDelete: SetNull)
  milestone_id  String?      @db.Uuid
  milestone     ZxMilestone? @relation(fields: [milestone_id], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(16, 2)
  tax           Decimal      @default(0) @db.Decimal(16, 2)
  status        String       @default("actual")
  payment_mode  String?
  reference     String?
  description   String?
  service_type  String?
  property_id   String?      @db.Uuid
  unit_id       String?      @db.Uuid
  source_type   String?
  source_id     String?      @db.Uuid
  created_by    String?      @db.Uuid
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now()) @updatedAt
  deleted_at    DateTime?

  @@index([org_id, entry_date])
  @@index([org_id, project_id])
  @@index([org_id, party_id])
  @@index([org_id, property_id])
  @@index([org_id, source_type, source_id])
  @@map("zx_ledger_entries")
}

// Z7: planned figures for a month, company-wide (project_id null) or for one project.
model ZxPlan {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id           String     @db.Uuid
  org              Org        @relation(fields: [org_id], references: [id], onDelete: Cascade)
  month            String
  project_id       String?    @db.Uuid
  project          ZxProject? @relation(fields: [project_id], references: [id], onDelete: Cascade)
  planned_revenue  Decimal    @default(0) @db.Decimal(16, 2)
  planned_expense  Decimal    @default(0) @db.Decimal(16, 2)
  planned_salaries Decimal    @default(0) @db.Decimal(16, 2)
  notes            String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @default(now()) @updatedAt

  @@index([org_id, month])
  @@map("zx_plans")
}

// Z7: a month's lock. status open | closed. snapshot = totals at close time; stale is set
// when a ledger entry or slip dated in the closed month changes afterwards (the snapshot is
// never silently rewritten - an admin reopens and re-closes).
model ZxPeriodClose {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String    @db.Uuid
  org           Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  month         String
  status        String    @default("open")
  snapshot      Json?
  closed_by     String?   @db.Uuid
  closed_at     DateTime?
  reopen_reason String?
  reopened_at   DateTime?
  stale         Boolean   @default(false)
  stale_at      DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  @@unique([org_id, month])
  @@map("zx_period_closes")
}

// Admin-recorded asset value per month for the valuation: (profit x 240) + (asset value x 3).
// A month without its own figure carries forward the latest earlier one.
model ZxAssetValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String   @db.Uuid
  org         Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  month       String
  asset_value Decimal  @db.Decimal(16, 2)
  notes       String?
  updated_by  String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@unique([org_id, month])
  @@map("zx_asset_values")
}

model ZxServiceType {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  org        Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  key        String
  label      String
  active     Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([org_id, key])
  @@map("zx_service_types")
}

// --- Zephyr real-estate (R3-R8) ---------------------------------------------------------------
// A property can be managed and traded at once; the lifecycle lives on its units.
model ZxProperty {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id              String    @db.Uuid
  org                 Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  code                String
  name                String
  property_type       String    @default("other") // plot | house | building | shops | office | commercial_complex | other
