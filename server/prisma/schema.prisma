// Supply side: one row per client delivery / sale.
model GxSale {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String      @db.Uuid
  org        Org         @relation(fields: [org_id], references: [id], onDelete: Cascade)
  deal_id    String      @db.Uuid
  deal       GxDeal      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
