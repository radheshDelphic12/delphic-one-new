// Append-only trail for superadmin record deletion / restore. `snapshot` holds the
// full row pre-image so a delete can be reviewed or reversed even without a DB dump.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String   @db.Uuid
  action      String // 'soft_delete' | 'restore'
  entity_type String
  entity_id   String   @db.Uuid
  reason      String
  snapshot    Json
  created_at  DateTime @default(now())

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
  org_id String? @db.Uuid
  org    Org?    @relation(fields: [org_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@index([org_id])
  @@map("audit_logs")
}

model Document {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type      DocumentEntityType
  entity_id        String             @db.Uuid
  label            String
  file_url         String
  file_type        String?
  file_size_bytes  Int?
  uploaded_by      String             @db.Uuid
  uploaded_by_user User               @relation(fields: [uploaded_by], references: [id])
  uploaded_at      DateTime           @default(now())

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
  org_id String? @db.Uuid
  org    Org?    @relation(fields: [org_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([org_id])
  @@map("documents")
}

model Comment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type CommentEntityType
  entity_id   String            @db.Uuid
  user_id     String            @db.Uuid
  user        User              @relation(fields: [user_id], references: [id])
  body        String
  created_at  DateTime          @default(now())

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
  org_id String? @db.Uuid
  org    Org?    @relation(fields: [org_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([org_id])
  @@map("comments")
}

// --- Vertical modules, email outbox, planning (multi-company brief, 2026-09) ---

enum EmailStatus {
  queued
  sent
  failed
  skipped
}

// Durable outbound-email queue. Business code only ever enqueues a row (never
// talks SMTP) and a job drains it, so a mail outage cannot fail a request and
// every send is auditable. `ics` carries an optional calendar-invite attachment.
model EmailOutbox {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String?     @db.Uuid
  org        Org?        @relation(fields: [org_id], references: [id])
  kind       String
  to_email   String
  to_name    String?
  subject    String
  body_text  String
  body_html  String?
  ics        String?
  status     EmailStatus @default(queued)
  attempts   Int         @default(0)
  last_error String?
  sent_at    DateTime?
  created_at DateTime    @default(now())

  @@index([status, created_at])
  @@index([org_id])
  @@map("email_outbox")
}

enum PartnerKind {
  supplier
  consumer
}

enum PartnerStatus {
  lead
  onboarding
  active
  inactive
}

enum TradingStatus {
  not_trading
  trading
  paused
}

enum TradeTxnType {
  purchase
  sale
}

enum TradeTxnStatus {
  open
  completed
  cancelled
}

// Gulati: supplier / consumer master. `status` is the onboarding funnel,
// `trading_status` is whether goods are actually moving.
model TradingPartner {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id               String        @db.Uuid
  org                  Org           @relation(fields: [org_id], references: [id])
  kind                 PartnerKind
  name                 String
  contact_name         String?
  email                String?
  phone                String?
  city                 String?
  gst_or_tax_id        String?
  status               PartnerStatus @default(lead)
  trading_status       TradingStatus @default(not_trading)
  onboarding_checklist Json          @default("{}")
  onboarded_at         DateTime?
  owner_id             String?       @db.Uuid
  notes                String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @default(now()) @updatedAt

  rates        PartnerItemRate[]
  transactions TradeTransaction[]

  @@index([org_id, kind, status])
  @@map("trading_partners")
}

model TradeItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  org        Org      @relation(fields: [org_id], references: [id])
  name       String
  sku        String?
  unit       String   @default("unit")
  category   String?
  hsn_code   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  rates        PartnerItemRate[]
  transactions TradeTransaction[]

  @@unique([org_id, name])
  @@map("trade_items")
}

// Rate-card line: what a partner buys/sells an item at, from a date. The
// newest row whose effective window covers a date wins.
model PartnerItemRate {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String         @db.Uuid
  org            Org            @relation(fields: [org_id], references: [id])
  partner_id     String         @db.Uuid
  partner        TradingPartner @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  item_id        String         @db.Uuid
  item           TradeItem      @relation(fields: [item_id], references: [id])
  rate           Decimal        @db.Decimal(14, 2)
  currency       Currency       @default(INR)
  effective_from DateTime       @db.Date
  effective_to   DateTime?      @db.Date
  created_by     String         @db.Uuid
  created_at     DateTime       @default(now())

  @@index([org_id, partner_id, item_id, effective_from])
  @@map("partner_item_rates")
}

model TradeTransaction {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String         @db.Uuid
  org        Org            @relation(fields: [org_id], references: [id])
  partner_id String         @db.Uuid
  partner    TradingPartner @relation(fields: [partner_id], references: [id])
  item_id    String         @db.Uuid
  item       TradeItem      @relation(fields: [item_id], references: [id])
  txn_type   TradeTxnType
  quantity   Decimal        @db.Decimal(14, 3)
  rate       Decimal        @db.Decimal(14, 2)
  amount     Decimal        @db.Decimal(16, 2)
  currency   Currency       @default(INR)
  status     TradeTxnStatus @default(open)
  txn_date   DateTime       @db.Date
  reference  String?
  created_by String         @db.Uuid
  created_at DateTime       @default(now())

  @@index([org_id, txn_date])
  @@index([org_id, partner_id])
  @@map("trade_transactions")
}

enum LeadCategory {
  self_project
  client_project
  other
}

// For a self_project lead: what is the deal built on?
enum SelfProjectBasis {
  investor
  customer_deal
  project_type
}

enum LeadStage {
  new
  contacted
  qualified
  proposal
  won
  lost
}

// Generic company lead (Zephyr, Acconcy). Separate from the recruitment
// Account pipeline on purpose: different stages, no client/vendor typing.
model Lead {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                String            @db.Uuid
  org                   Org               @relation(fields: [org_id], references: [id])
  name                  String
  category              LeadCategory      @default(other)
  self_project_basis    SelfProjectBasis?
  investor_name         String?
  customer_deal_ref     String?
  project_type          String?
  contact_name          String?
  email                 String?
  phone                 String?
  source                String?
  estimated_value       Decimal?          @db.Decimal(16, 2)
  expected_monthly      Decimal?          @db.Decimal(14, 2)
  currency              Currency          @default(INR)
  stage                 LeadStage         @default(new)
  owner_id              String?           @db.Uuid
  notes                 String?
  converted_project_id  String?           @db.Uuid
  converted_contract_id String?           @db.Uuid
  created_at            DateTime          @default(now())
  updated_at            DateTime          @default(now()) @updatedAt

  @@index([org_id, stage])
  @@index([org_id, category])
  @@map("leads")
}

enum ContractKind {
  construction
  recurring
  service
}

enum ContractStatus {
  draft
  active
  completed
  terminated
}

enum BillingFrequency {
  one_time
  monthly
  quarterly
  annual
}

// Zephyr construction contracts and Acconcy recurring-revenue contracts.
// For recurring ones `recurring_amount` is billed per `billing_frequency`
// period; MRR normalises that to a month.
model Contract {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id            String           @db.Uuid
  org               Org              @relation(fields: [org_id], references: [id])
  kind              ContractKind
  title             String
  counterparty_name String
  lead_id           String?          @db.Uuid
  project_id        String?          @db.Uuid
  project           SelfProject?     @relation(fields: [project_id], references: [id])
  value             Decimal          @default(0) @db.Decimal(16, 2)
  currency          Currency         @default(INR)
  status            ContractStatus   @default(draft)
  start_date        DateTime         @db.Date
  end_date          DateTime?        @db.Date
  billing_frequency BillingFrequency @default(one_time)
  recurring_amount  Decimal?         @db.Decimal(14, 2)
  progress_percent  Int              @default(0)
  billed_to_date    Decimal          @default(0) @db.Decimal(16, 2)
  site_location     String?
  notes             String?
  created_by        String           @db.Uuid
  created_at        DateTime         @default(now())
  updated_at        DateTime         @default(now()) @updatedAt

  @@index([org_id, status])
  @@index([org_id, kind])
  @@map("contracts")
}

enum SelfProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum FinanceEntryType {
  revenue
  expense
  salary
  other
}

enum ProjectDocCategory {
  legal
  site
  permit
  approval
  title
  other
}

model SelfProject {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id            String            @db.Uuid
  org               Org               @relation(fields: [org_id], references: [id])
  name              String
  project_type      String?
  status            SelfProjectStatus @default(planning)
  location          String?
  investor_name     String?
  customer_deal_ref String?
  lead_id           String?           @db.Uuid
  budget            Decimal?          @db.Decimal(16, 2)
  currency          Currency          @default(INR)
  start_date        DateTime?         @db.Date
  end_date          DateTime?         @db.Date
  notes             String?
  created_by        String            @db.Uuid
  created_at        DateTime          @default(now())
  updated_at        DateTime          @default(now()) @updatedAt

  contracts Contract[]
  finance   ProjectFinanceEntry[]
  documents ProjectDocument[]

  @@index([org_id, status])
  @@map("self_projects")
}

model ProjectFinanceEntry {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String           @db.Uuid
  org         Org              @relation(fields: [org_id], references: [id])
  project_id  String           @db.Uuid
  project     SelfProject      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  entry_type  FinanceEntryType
  category    String?
  amount      Decimal          @db.Decimal(16, 2)
  currency    Currency         @default(INR)
  entry_date  DateTime         @db.Date
  description String?
  created_by  String           @db.Uuid
  created_at  DateTime         @default(now())

  @@index([org_id, entry_date])
  @@index([project_id, entry_type])
  @@map("project_finance_entries")
}

model ProjectDocument {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          String             @db.Uuid
  org             Org                @relation(fields: [org_id], references: [id])
  project_id      String             @db.Uuid
  project         SelfProject        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  category        ProjectDocCategory
  title           String
  reference_no    String?
  issued_on       DateTime?          @db.Date
  expires_on      DateTime?          @db.Date
  notes           String?
  file_url        String?
  file_type       String?
  file_size_bytes Int?
  uploaded_by     String             @db.Uuid
  created_at      DateTime           @default(now())

  @@index([org_id, project_id])
  @@index([org_id, expires_on])
  @@map("project_documents")
}

// Budget line for a month, compared with derived actuals in the plan view.
// `category` of '' means the whole line kind.
model FinancialPlan {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String           @db.Uuid
  org            Org              @relation(fields: [org_id], references: [id])
  period_month   Int
  period_year    Int
  line_kind      FinanceEntryType
  category       String           @default("")
  planned_amount Decimal          @db.Decimal(16, 2)
  notes          String?
  created_by     String           @db.Uuid
  created_at     DateTime         @default(now())
  updated_at     DateTime         @default(now()) @updatedAt

  @@unique([org_id, period_year, period_month, line_kind, category])
  @@map("financial_plans")
}

// "Face" resource = the person who fronts the client relationship for a piece
// of work; "working" resource = the person who does it (logs the timesheets).
// Revenue earned by the working resource is attributed to the face resource
// in the resource-wise revenue report.
model ResourceMapping {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                String    @db.Uuid
  org                   Org       @relation(fields: [org_id], references: [id])
  face_membership_id    String    @db.Uuid
  working_membership_id String    @db.Uuid
  account_id            String?   @db.Uuid
  effective_from        DateTime  @db.Date
  effective_to          DateTime? @db.Date
  created_by            String    @db.Uuid
  created_at            DateTime  @default(now())

  @@index([org_id, working_membership_id])
  @@index([org_id, face_membership_id])
  @@map("resource_mappings")
}
