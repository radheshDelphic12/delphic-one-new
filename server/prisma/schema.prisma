  sale_date  DateTime    @db.Date
  quantity   Decimal?    @db.Decimal(16, 3)
  rate       Decimal?    @db.Decimal(16, 2)
  amount     Decimal     @db.Decimal(16, 2)
  tax        Decimal     @default(0) @db.Decimal(16, 2)
  reference  String?
  notes      String?
  created_by String?     @db.Uuid
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  deleted_at DateTime?
  payments   GxPayment[]

  @@index([org_id, sale_date])
  @@index([deal_id])
  @@map("gx_sales")
}

// Cash movement against a purchase (side vendor: paid out) or a sale (side client: received).
model GxPayment {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String      @db.Uuid
  org         Org         @relation(fields: [org_id], references: [id], onDelete: Cascade)
  deal_id     String      @db.Uuid
  deal        GxDeal      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  side        String // vendor | client
  purchase_id String?     @db.Uuid
  purchase    GxPurchase? @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  sale_id     String?     @db.Uuid
  sale        GxSale?     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(16, 2)
  paid_date   DateTime    @db.Date
  mode        String?
  reference   String?
  notes       String?
  created_by  String?     @db.Uuid
  created_at  DateTime    @default(now())
  updated_at  DateTime    @default(now()) @updatedAt
  deleted_at  DateTime?

  @@index([org_id, paid_date])
  @@index([deal_id])
  @@map("gx_payments")
}

// Deal expenses (deal_id set) and company-level income / expense (deal_id null).
model GxLedgerEntry {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id       String     @db.Uuid
  org          Org        @relation(fields: [org_id], references: [id], onDelete: Cascade)
  entry_date   DateTime   @db.Date
  type         String // revenue | expense
  category_id  String     @db.Uuid
  category     GxCategory @relation(fields: [category_id], references: [id])
  deal_id      String?    @db.Uuid
  deal         GxDeal?    @relation(fields: [deal_id], references: [id], onDelete: SetNull)
  party_id     String?    @db.Uuid
  amount       Decimal    @db.Decimal(16, 2)
  tax          Decimal    @default(0) @db.Decimal(16, 2)
  payment_mode String?
  reference    String?
  description  String?
  created_by   String?    @db.Uuid
  created_at   DateTime   @default(now())
  updated_at   DateTime   @default(now()) @updatedAt
  deleted_at   DateTime?

  @@index([org_id, entry_date])
  @@index([org_id, deal_id])
  @@map("gx_ledger_entries")
}

// status: pending | in_progress | done | cancelled. priority: low | medium | high.
model GxTask {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String    @db.Uuid
  org           Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  code          String?
  title         String
  task_type     String    @default("other")
  deal_id       String?   @db.Uuid
  deal          GxDeal?   @relation(fields: [deal_id], references: [id], onDelete: SetNull)
  lead_id       String?   @db.Uuid
  party_id      String?   @db.Uuid
  assignee_id   String?   @db.Uuid
  contractor_id String?   @db.Uuid
  due_date      DateTime? @db.Date
  priority      String    @default("medium")
  status        String    @default("pending")
  completed_on  DateTime? @db.Date
  description   String?
  notes         String?
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt
  deleted_at    DateTime?

  @@index([org_id, status])
  @@index([org_id, due_date])
  @@map("gx_tasks")
}

// A month's lock. snapshot = totals at close time; stale is set when money dated in the closed month changes later.
model GxPeriodClose {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String    @db.Uuid
  org           Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  month         String
  status        String    @default("open")
  snapshot      Json?
  closed_by     String?   @db.Uuid
  closed_at     DateTime?
  reopen_reason String?
  reopened_at   DateTime?
  stale         Boolean   @default(false)
  stale_at      DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  @@unique([org_id, month])
  @@map("gx_period_closes")
}

// Admin-recorded asset value per month for the valuation: (net profit x 240) + (asset value x 3).
// A month without its own figure carries forward the latest earlier one.
model GxAssetValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id      String   @db.Uuid
  org         Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  month       String
  asset_value Decimal  @db.Decimal(16, 2)
  notes       String?
  updated_by  String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@unique([org_id, month])
  @@map("gx_asset_values")
}
