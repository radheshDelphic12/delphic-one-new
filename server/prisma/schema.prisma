}

// ---------------------------------------------------------------------------
// Gulati Industries workspace (standalone Gx* module, 2026-10): a trading company
// (Copper Cathode and other deals). Mirrors the Zephyr Zx* pattern: every row is
// org-scoped and services filter by org_id explicitly. See
// docs/features/GULATI-INDUSTRIES.md.
// ---------------------------------------------------------------------------

model GxSetting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id             String   @unique @db.Uuid
  org                Org      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  currency           String   @default("INR")
  valuation_method   String   @default("revenue_multiple") // manual | revenue_multiple | profit_multiple
  valuation_multiple Decimal  @default(1) @db.Decimal(8, 2)
  valuation_manual   Decimal? @db.Decimal(16, 2)
  lead_prefix        String   @default("GL")
  lead_seq           Int      @default(0)
  deal_prefix        String   @default("GD")
  deal_seq           Int      @default(0)
  task_prefix        String   @default("GT")
  task_seq           Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  @@map("gx_settings")
}

// Admin-editable revenue / expense categories.
model GxCategory {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String          @db.Uuid
  org        Org             @relation(fields: [org_id], references: [id], onDelete: Cascade)
  kind       String // revenue | expense
  name       String
  active     Boolean         @default(true)
  sort_order Int             @default(0)
  created_at DateTime        @default(now())
  updated_at DateTime        @default(now()) @updatedAt
  deleted_at DateTime?
  entries    GxLedgerEntry[]

  @@unique([org_id, kind, name])
  @@index([org_id, kind])
  @@map("gx_categories")
}

// Admin-editable quantity units (Kg, MT, Ton, Piece ...).
model GxUnit {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String    @db.Uuid
  org        Org       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  name       String
  active     Boolean   @default(true)
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

