// Person (User) <-> Org join. "Different roles in different companies" lives
// here: one User row, one OrgMembership row per company they work at.
model OrgMembership {
  id                          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  person_id                   String           @db.Uuid
  person                      User             @relation("OrgMembershipPerson", fields: [person_id], references: [id])
  org_id                      String           @db.Uuid
  org                         Org              @relation(fields: [org_id], references: [id])
  role                        UserRole
  employee_code               String?
  department_id               String?          @db.Uuid
  department                  Department?      @relation(fields: [department_id], references: [id])
  // Multi-company ERP (Phase 2) — nullable, unused until a designation is set.
  designation_id              String?          @db.Uuid
  designation                 Designation?     @relation(fields: [designation_id], references: [id])
  // HR Settings → Teams, and how the person works (reuses the Requirement
  // WorkMode enum). Both optional — unset until HR assigns them.
  team_id                     String?          @db.Uuid
  team                        Team?            @relation("TeamMembers", fields: [team_id], references: [id], onDelete: SetNull)
  work_mode                   WorkMode?
  // Full-time employee vs contractor. A contractor's cost is vendor_rate
  // (monthly, in vendor_rate_currency) payable to vendor_account — the
  // vendor company — and never goes through payroll.
  worker_type                 WorkerType       @default(full_time_employee)
  // What this person's salary is worked out from: 'timesheet' (approved timesheet hours - the original
  // rule, and what null means) or 'attendance' (check-in / half day / leave / absent marking; the
  // project timesheet then only feeds client billing). Set by an admin, per person or in bulk for IT.
  // Leave Manager: processes (approves / rejects) leave requests for the whole company; an admin keeps final control.
  is_leave_manager            Boolean          @default(false)
  pay_basis                   String?
  vendor_account_id           String?          @db.Uuid
  vendor_account              Account?         @relation("MembershipVendorAccount", fields: [vendor_account_id], references: [id], onDelete: SetNull)
  vendor_rate                 Decimal?         @db.Decimal(14, 2)
  vendor_rate_currency        Currency?
  // Added 2026-09-15 (client brief) — all nullable, unused until set.
  location_id                 String?          @db.Uuid
  location                    Location?        @relation(fields: [location_id], references: [id])
  shift_id                    String?          @db.Uuid
  shift                       Shift?           @relation(fields: [shift_id], references: [id])
  // Reporting line for the org-chart module (Phase 10, not built yet) — a
  // self-relation, so a manager is just another OrgMembership in this org.
  manager_id                  String?          @db.Uuid
  manager                     OrgMembership?   @relation("OrgMembershipManager", fields: [manager_id], references: [id], onDelete: SetNull)
  direct_reports              OrgMembership[]  @relation("OrgMembershipManager")
  // HR contact for general queries, and the recruiter who onboarded this
  // person (for recruiter-performance tracking) — both point at User, not
  // OrgMembership, since an HR/sourcing POC may not share this org.
  hr_poc_id                   String?          @db.Uuid
  hr_poc                      User?            @relation("OrgMembershipHrPoc", fields: [hr_poc_id], references: [id])
  sourcing_poc_id             String?          @db.Uuid
  sourcing_poc                User?            @relation("OrgMembershipSourcingPoc", fields: [sourcing_poc_id], references: [id])
  employment_status           EmploymentStatus @default(active)
  // Bank account for salary and emergency contact — the employee keeps these
  // up to date from their own portal (Settings → My details); admins can too.
  // Never part of the org-wide membership read, which any member can call.
  bank_account_holder         String?
  bank_name                   String?
  bank_account_number         String?
  bank_ifsc                   String?
  bank_branch                 String?
  // Identity numbers printed on the payslip (employee-editable like the bank details).
  aadhaar_number              String?
  pan_number                  String?
  emergency_contact_name      String?
  emergency_contact_relation  String?
  emergency_contact_phone     String?
  emergency_contact_email     String?
  personal_details_updated_at DateTime?
  joined_at                   DateTime         @default(now()) @db.Date
  left_at                     DateTime?        @db.Date
  // Notice period: the day notice was given (resignation) and the last
  // working day (LWD, notice_end_date). Set from the employee profile with
  // employment_status = notice_period; left_at follows the LWD on exit.
  notice_start_date           DateTime?        @db.Date
  notice_end_date             DateTime?        @db.Date
  created_at                  DateTime         @default(now())
  updated_at                  DateTime         @default(now()) @updatedAt

  employee_calendars      EmployeeCalendar[]
  attendance_records      AttendanceRecord[]
  leave_balances          LeaveBalance[]
  leave_requests          LeaveRequest[]                  @relation("LeaveRequestOwner")
  leave_requests_approved LeaveRequest[]                  @relation("LeaveRequestApprover")
  timesheet_entries       TimesheetEntry[]
  timesheet_overtime      TimesheetDayOvertime[]
  overtime_tickets        OvertimeTicket[]
  salary_adjustments      SalaryAdjustment[]
  salary_payments         SalaryPayment[]
  salary_structures       SalaryStructure[]
  payslips                Payslip[]
  daily_profitability     DailyEmployeeProfitability[]
  expense_claims          ExpenseClaim[]
  assigned_tasks          AssignedTask[]
  project_cost_rates      ProjectMemberAssignment[]
  regularization_requests TimesheetRegularizationTicket[] @relation("RegularizationMembership")
  teams_led               Team[]                          @relation("TeamLead")
  team_periods            TeamMembershipPeriod[]
  teams_managed           Team[]                          @relation("TeamManager")
  assets                  Asset[]

  @@unique([person_id, org_id])
  // Employee codes are unique within a company (null = none yet).
  @@unique([org_id, employee_code])
  @@index([team_id])
  @@index([vendor_account_id])
  @@index([org_id])
  @@index([person_id])
  @@index([manager_id])
  @@map("org_memberships")
}

model Account {
  id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type  AccountType?
  name  String
  stage AccountStage @default(lead)

  industry         String?
  company_size     CompanySize?
  website          String?
  location_city    String?
  location_country String?
  gst_or_tax_id    String?

  location     String?
  linkedin_url String?

  poc_name        String?
  poc_email       String?
  poc_phone       String?
  poc_designation String?

  additional_contacts Json @default("[]")

  source           String?
  meeting_mode     MeetingMode?
  meeting_date     DateTime?
  meeting_location String?
  meeting_notes    String?

  vendor_specializations String[]
  vendor_rate_range      Json?
  vendor_payment_terms   String?
  vendor_agreement_url   String?

  client_billing_currency Currency?
  client_payment_terms    String?
  client_agreement_url    String?

  // Project cost budget — Module C (project costing). Currency follows
  // client_billing_currency above (no separate field). Remaining budget is
  // computed live (budget_amount - cost incurred from approved+billable
  // TimesheetEntry hours × ProjectMemberAssignment.cost_rate_per_hr), never
  // stored, so it can't drift from the underlying entries.
  budget_amount Decimal? @db.Decimal(14, 2)

  // Project profile (a "Project" is an active client Account — see
  // calendars.service.createProject). project_name is the name shown for the
  // project and the only name Finance edits; null means it still matches the
  // account's own `name`, which Finance never renames (the same row can be a
  // real client account other projects link to). client_name is the company
  // it is delivered for. service_category reuses ReqType
  // (managed_services | project; recruitment is not offered for now).
  // Billing type/rate is NOT stored here — it's the effective BillingRate row,
  // so there is one source of truth. Nothing is billed before
  // agreement_start_date. benchmark_hours is the monthly-billing benchmark.
  project_name            String?
  // Contract tracking: when the agreement ends, and a manual hold / completed
  // override (null = worked out from the dates — not started / running /
  // about to end / completed).
  agreement_end_date      DateTime?              @db.Date
  contract_status         ProjectContractStatus?
  client_name             String?
  // The project's client, picked from this org's client accounts (client or
  // unclassified, any stage). client_name above is kept as a snapshot of the
  // picked account's name, and is the only value legacy projects created
  // before this link have.
  client_account_id       String?                @db.Uuid
  client_account          Account?               @relation("ProjectClientAccount", fields: [client_account_id], references: [id], onDelete: SetNull)
  client_projects         Account[]              @relation("ProjectClientAccount")
  service_category        ReqType?
  agreement_start_date    DateTime?              @db.Date
  benchmark_hours         Int                    @default(160)
  // Finance's internal project/contract id (P0001, P0002 …), unique per org.
  // The project NAME is only a label — two contracts with the same name (the
  // same client taking a second resource later) are separate projects with
  // their own resources, dates, rates, billing and P&L; this code (and the
  // row's uuid) is what tells them apart.
  project_code            String?
  // True for a project/contract created through Add Project. Projects live in
  // this table next to client companies (both type 'client'), so this flag is
  // what keeps them apart: the Accounts catalogue never lists, edits or deletes
  // a project, and Finance only edits projects — a catalogue client account
  // listed in Finance is read-only there.
  is_project              Boolean                @default(false)
  // Whether the client pays for overtime on this contract. The project's own
  // setting is the source of truth: Billing & Sales only ever adds approved
  // overtime for a project where this is on. `overtime_multiplier` scales the
  // hourly-equivalent rate for those hours (1 = straight time, 1.5 = time and
  // a half).
  overtime_billable       Boolean                @default(false)
  overtime_multiplier     Decimal                @default(1) @db.Decimal(5, 2)
  // Hourly projects: the approximate hours per month the client expects to
  // use. A forecast only — Billing & Sales shows estimated revenue (these
  // hours × the hourly rate) beside the actual revenue from approved hours;
  // billing, locks and invoices never read it. Null = no estimate.
  estimated_monthly_hours Decimal?               @db.Decimal(7, 2)
  // Hourly contracts: the minimum hours a month the client committed to.
  // Months below it are flagged (shortfall) — billing itself is unchanged.
  minimum_monthly_hours   Decimal?               @db.Decimal(7, 2)
  // How the client month is billed on a MONTHLY rate:
  //   contract       - rate x contract working days / working days (the retainer,
  //                    never scaled by hours - the original behaviour);
  //   approved_hours - the same share, but each working day counts only for the
  //                    approved timesheet hours logged on it (day = billable_day_hours).
  // Hourly rates always bill approved hours x rate.
  client_billing_basis    String                 @default("contract")
  // How a contractor's vendor payout is worked out for this project (same two
  // options). Default approved_hours: pay for the locked, approved days actually worked.
  vendor_payout_basis     String                 @default("approved_hours")
  // Hours that make a full billable / payable day under approved_hours.
  billable_day_hours      Decimal                @default(8) @db.Decimal(4, 2)
  // Client billing statuses for monthly-billed resources (separate from salary leave rules):
  // the fraction of a day's rate billed for each status, e.g. { "pl": 1, "npl": 0, "comp_off": 1,
  // "first_half": 0.5, "second_half": 0.5, "half_day": 0.5 }. null = the defaults.
  billing_leave_rules     Json?
  billing_adjustments     BillingAdjustment[]
  contract_charges        ContractCharge[]
  overtime_tickets        OvertimeTicket[]

  owner_id           String    @db.Uuid
  owner              User      @relation("AccountOwner", fields: [owner_id], references: [id])
  // Immutable "brought by" — the BDA/admin who first added this client/vendor.
  // Set once at creation and never changed; owner_id may later be reassigned.
  origin_owner_id    String?   @db.Uuid
  origin_owner       User?     @relation("AccountOriginOwner", fields: [origin_owner_id], references: [id])
  classified_at      DateTime?
  classified_by      String?   @db.Uuid
  classified_by_user User?     @relation("AccountClassifiedBy", fields: [classified_by], references: [id])
  is_locked          Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt

  // Superadmin soft-delete (see AuditLog + the $use filter in config/db.js).
  deleted_at    DateTime?
  deleted_by    String?   @db.Uuid
  delete_reason String?

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
  org_id String? @db.Uuid
  org    Org?    @relation(fields: [org_id], references: [id])

  requirements               Requirement[]
  vendor_profiles            Profile[]                       @relation("ProfileVendorAccount")
  meeting_attendees          AccountMeetingAttendee[]
  employee_calendar_mappings EmployeeCalendar[]              @relation("EmployeeCalendarAccount")
  timesheet_entries          TimesheetEntry[]                @relation("TimesheetAccount")
  billing_rates              BillingRate[]                   @relation("BillingRateAccount")
  daily_project_revenues     DailyProjectRevenue[]           @relation("DailyRevenueAccount")
  client_invoices            ClientInvoice[]                 @relation("ClientInvoiceAccount")
  vendor_commissions         VendorCommission[]              @relation("VendorCommissionAccount")
  assigned_tasks             AssignedTask[]
  project_cost_rates         ProjectMemberAssignment[]
  regularization_tickets     TimesheetRegularizationTicket[] @relation("RegularizationAccount")
  project_calendar           ProjectCalendar?                @relation("ProjectCalendarAccount")
  contractor_memberships     OrgMembership[]                 @relation("MembershipVendorAccount")
  project_vendor_invoices    ProjectVendorInvoice[]          @relation("ProjectVendorInvoiceProject")
  vendor_invoices_raised     ProjectVendorInvoice[]          @relation("ProjectVendorInvoiceVendor")
  assets_supplied            Asset[]                         @relation("AssetVendor")
  assets_at_client           Asset[]                         @relation("AssetClient")

  @@unique([org_id, project_code])
  @@index([type, stage])
  @@index([owner_id])
  @@index([origin_owner_id])
  @@index([deleted_at])
  @@index([org_id])
  @@index([client_account_id])
  @@map("accounts")
}

