## ERP-branch env template (`feature/multi-company-erp`)
##
## Points at a SEPARATE local database (`requirement_dashboard_erp`) inside the
## same Docker Postgres container used for day-to-day dev — the ordinary
## `requirement_dashboard` DB and your regular `server/.env` are untouched.
## Copy this to `server/.env` only while you're working this branch:
##   cp server/.env.erp.example server/.env
## Switch back to normal recruitment-dashboard work with:
##   cp server/.env.example server/.env   (then set your real JWT secrets)
##
## To run BOTH stacks side by side instead of swapping, use this file as-is
## with a second terminal (`PORT=4001` below) instead of copying over .env.

NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

# Small explicit pool — this stack + your normal dev server + jest all share
# one Postgres instance (localhost:5434). See
# docs/guides/DATABASE-CONNECTION-POOLING.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/requirement_dashboard_erp?connection_limit=10&pool_timeout=20

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

CORS_ORIGIN=http://localhost:5173

APP_TIMEZONE=Asia/Kolkata

UPLOAD_DIR=./uploads-erp
MAX_UPLOAD_MB=10

ENABLE_JOBS=true
