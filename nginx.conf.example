# Host nginx fronting the Docker client container on loopback :8081.
#
# Install:
#   sudo cp nginx.conf.example /etc/nginx/sites-available/delphic
#   sudo sed -i 's/your-domain.example/app.yourdomain.com/g' /etc/nginx/sites-available/delphic
#   sudo ln -sf /etc/nginx/sites-available/delphic /etc/nginx/sites-enabled/delphic
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then obtain TLS. Certbot rewrites this file to add the 443 server block and
# the HTTP-to-HTTPS redirect, so this file stays HTTP-only on purpose:
#   sudo certbot --nginx -d app.yourdomain.com

server {
    listen 80;
    server_name your-domain.example;

    # Must exceed MAX_UPLOAD_MB (default 10) with headroom.
    client_max_body_size 12m;

    # Database snapshot viewer (super admin only, its own container on loopback :8090). The trailing slash on proxy_pass strips
    # /dbviewer/, so the viewer sees "/". Every API call is checked against the app's login, so this is not an open door.
    location /dbviewer/ {
        proxy_pass http://127.0.0.1:8090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # a comparison or an export can take a while
        proxy_buffering off;       # stream XLSX / CSV downloads instead of buffering them
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
