# docker-compose environment overrides — copy to .env and fill before production.
# Generate secrets with: openssl rand -hex 32
# Do not use placeholder strings; production refuses weak JWT secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=local_multiCompany
POSTGRES_PORT=5435

# Prisma connection pool, per app instance — explicit rather than Prisma's
# default guess (num_physical_cpus*2+1, unreliable under Docker's cgroup
# reporting). See docs/guides/DATABASE-CONNECTION-POOLING.md.
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

API_PORT=4000
CLIENT_PORT=8081

# Public HTTPS origin of the SPA (e.g. https://app.example.com). Required in production.
CORS_ORIGIN=http://localhost:8081
APP_DOMAIN=localhost

# Server logging (passed into the server service). See docs/BACKEND-LOGGING.md
LOG_LEVEL=info

# In-process background jobs (interview reminder cron). Runs unless set to false;
# always off under NODE_ENV=test. See docs/guides/DEPLOY-RUNBOOK.md.
ENABLE_JOBS=true
